**/zz-*

# Camoufox browser-profile data: live session cookies, saved logins and the key that
# decrypts them. It lives at ~/.local/share/camoufox/profiles/ and must never be inside a
# checkout — this is the backstop for a stray copy, or a CAMOUFOX_PROFILE aimed here.
camoufox-profile*/
**/cookies.sqlite*
**/key4.db
**/logins.json
